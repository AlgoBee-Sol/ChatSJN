MONGODB_URI=mongodb://127.0.0.1:27017/sjn_ai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
RAG_SEARCH_BACKEND=local
RAG_MIN_SCORE=0.45
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Optional Google OAuth Web application credentials (server-only; never prefix with VITE_)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
PORT=3001
UPLOAD_DIR=.local/uploads
CHUNK_SIZE=1600
CHUNK_OVERLAP=200

# Enable only when a reviewed public site is ready to be indexed
PUBLIC_INDEXING=false
SITE_URL=
